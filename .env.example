# Token du bot (Discord Developer Portal > ton application > Bot > Reset Token)
DISCORD_TOKEN=

# Mode 1 (recommandé) : le bot suit cet utilisateur dans les salons vocaux.
# Clic droit sur ton pseudo > "Copier l'identifiant" (mode développeur activé).
FOLLOW_USER_ID=

# Mode 2 : le bot rejoint toujours ce salon vocal précis.
GUILD_ID=
VOICE_CHANNEL_ID=

# Port du serveur web (l'affichage sera sur http://<ip-de-ce-pc>:PORT)
PORT=3000

# Optionnel : clé exigée pour se connecter à l'affichage (?key=...).
# Conseillé si tu exposes l'affichage sur Internet (tunnel, VPS...).
VIEW_KEY=
