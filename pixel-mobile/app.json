{
  "expo": {
    "name": "Pixel",
    "slug": "pixel",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141713",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mopi.pixel",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#d9d2bd",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.HIGH_SAMPLING_RATE_SENSORS"],
      "blockedPermissions": ["android.permission.ACTIVITY_RECOGNITION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true, "buildArchs": ["arm64-v8a"] } }],
      ["expo-camera", { "cameraPermission": "Pixel utilise l'appareil photo pour scanner son QR code.", "microphonePermission": false, "recordAudioAndroid": false }],
      "./modules/pixel-native/app.plugin.js"
    ]
  }
}
